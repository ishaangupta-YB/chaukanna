# Web app configuration. Copy to apps/web/.env.local and fill the empty values from
# infra/cdk-outputs.json (ChaukannaStack outputs). This file is committed to a public repo:
# fixed values only. The invite signing key lives in Secrets Manager
# (chaukanna/invite-signing-key) and is read at runtime; never put it here.
#
# On Amplify, set TABLE_NAME, ARTIFACTS_BUCKET, USER_POOL_ID, USER_POOL_CLIENT_ID,
# COGNITO_DOMAIN and VOICE_REGION as console environment variables. amplify.yml writes them to
# .env.production for the SSR runtime. Do not set AWS_PROFILE or AWS_REGION there.

# Local only: the CLI profile from docs/AWS_SETUP.md. On Amplify the compute role is used.
AWS_PROFILE=chaukanna
# Local only. On Amplify the SSR runtime sets AWS_REGION (the AWS_ prefix is reserved there).
AWS_REGION=ap-south-1
VOICE_REGION=ap-northeast-1

# Output TableName
TABLE_NAME=chaukanna
# Output ArtifactsBucketName, chaukanna-artifacts-<account id>
ARTIFACTS_BUCKET=
# Output UserPoolId, ap-south-1_xxxxxxxxx
USER_POOL_ID=
# Output UserPoolClientId
USER_POOL_CLIENT_ID=
# Output CognitoDomain: host name without https://
COGNITO_DOMAIN=
# Public origin of the app. http://localhost:3000 locally. On Amplify it defaults to
# https://<branch>.<appId>.amplifyapp.com; set it only for a custom domain.
APP_URL=http://localhost:3000
