# Web app configuration. Copy to .env.local and fill from infra/cdk-outputs.json.
# Non-secret values only. The invite signing key lives in Secrets Manager
# (chaukanna/invite-signing-key) and is read at runtime; never put it here.

# Local only: your SSO profile. On Amplify the compute role is used instead.
AWS_PROFILE=chaukanna
# Local only. On Amplify the SSR runtime sets AWS_REGION (the AWS_ prefix is reserved there).
AWS_REGION=ap-south-1
VOICE_REGION=ap-northeast-1

TABLE_NAME=chaukanna
ARTIFACTS_BUCKET=
USER_POOL_ID=
USER_POOL_CLIENT_ID=
# Managed login host name without https://, from the CognitoDomain output
COGNITO_DOMAIN=
# Public origin of the app. http://localhost:3000 locally, the Amplify URL when deployed.
APP_URL=http://localhost:3000
