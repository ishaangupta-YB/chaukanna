# Chaukanna environment variables, every package.
# This file is committed to a PUBLIC repository: fixed, non-identifying values only.
# Real per-account values go in a gitignored .env.local (apps/web/.env.local for the web app),
# copied from infra/cdk-outputs.json, which `cdk deploy --outputs-file cdk-outputs.json` writes.
# Secrets never appear in any env file: they live in Secrets Manager and are read at runtime.

# ---- Local AWS access (your machine only, never Amplify, never CI) ------------------------
# The named CLI profile from docs/AWS_SETUP.md step 4. Deployed code uses IAM roles instead.
AWS_PROFILE=chaukanna

# ---- Regions (never hardcode them in code) ------------------------------------------------
# App and data. Local only for the web app: Amplify reserves the AWS_ prefix and its SSR
# runtime sets AWS_REGION itself.
AWS_REGION=ap-south-1
# Voice path. Nova 2 Sonic is not offered in ap-south-1.
VOICE_REGION=ap-northeast-1

# ---- Phase 1, from infra/cdk-outputs.json (ChaukannaStack) --------------------------------
TABLE_NAME=chaukanna
# Output ArtifactsBucketName, chaukanna-artifacts-<account id>
ARTIFACTS_BUCKET=
# Output UserPoolId, ap-south-1_xxxxxxxxx
USER_POOL_ID=
# Output UserPoolClientId (public PKCE client, no secret)
USER_POOL_CLIENT_ID=
# Output CognitoDomain, host name without https://, chaukanna-xxxxxxxx.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=
# Public origin of the web app. On Amplify, amplify.yml defaults it to https://<branch>.<appId>.amplifyapp.com
APP_URL=http://localhost:3000

# ---- Judge demo mode: AN AUTHENTICATION BYPASS. Read this before setting it. --------------
# DEMO_MODE=on turns /api/demo/start into a one-click way for ANYONE who can reach the site to
# get a working guardian dashboard with NO password, NO Google account and NO invitation. Each
# click mints a throwaway identity and seeds its own household, so nobody ever lands in a real
# guardian's data, the dashboard wears a "Demo session" badge, and the cookie lasts two hours.
# It exists so hackathon judges can try the product without credentials.
#
# It must be empty, or anything other than the exact string "on", on any deployment a real
# family uses. With it off, /api/demo/* answers 404 and a demo cookie is ignored completely.
# Demo households are identifiable for cleanup: ownerSub begins with "demo-".
DEMO_MODE=

# Not an env var the app reads, listed for reference: Secrets Manager id of the invite HMAC key
# (output InviteSigningKeySecretName). The value itself is generated by AWS and never leaves it.
# INVITE_SIGNING_KEY_SECRET_ID=chaukanna/invite-signing-key

# ---- Phase 2, the drill agent (apps/agent) ------------------------------------------------
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
# Hard cap on a drill, enforced by a timer (10..900).
SESSION_MAX_SECONDS=360
SAFE_WORD=ROKO
# Optional: extra spellings speech recognition may produce for a custom safe word, comma separated.
SAFE_WORD_SPELLINGS=
# Optional: Nova caps a connection near 8 minutes; the SDK reconnects before this (20..470).
# Lower it locally to exercise the reconnect path.
MODEL_RESTART_AFTER_SECONDS=420

# ---- Phase 4, drill lifecycle, from infra/cdk-outputs.json (ChaukannaStack) ---------------
# Output RingLambdaArn. The function an EventBridge schedule invokes when a drill's moment comes.
RING_LAMBDA_ARN=
# Output SchedulerInvokeRoleArn. The role EventBridge Scheduler assumes to invoke that function;
# the web app passes it when it creates a schedule, so the compute role needs iam:PassRole on it.
SCHEDULER_INVOKE_ROLE_ARN=

# Not an env var the web app reads, listed for reference: the address the ring nudge is sent from.
# It is passed at deploy time, never stored here, because an address is personal data and this
# repository is public:  npx cdk deploy ChaukannaStack -c chaukanna:senderEmail=<address>

# ---- Phase 5, scoring and debrief, from infra/cdk-outputs.json (ChaukannaStack) ----------
# Output ScoringStateMachineArn. The agent starts one execution per finished drill; it is set on
# the AgentCore runtime by ChaukannaVoiceStack, so nothing has to be pasted into Amplify for it.
SCORING_STATE_MACHINE_ARN=
# Output GuardrailId. The Bedrock guardrail applied to a transcript before the first durable write.
GUARDRAIL_ID=
# Output GuardrailVersion. Always DRAFT: the guardrail is defined in CDK, so DRAFT is what is
# deployed and a redeploy takes effect immediately. There is no published version to bump.
GUARDRAIL_VERSION=DRAFT
# Output JudgeModelId. An inference profile, not a bare model id: this model family does not
# support on-demand throughput and the bare id fails at runtime, not at deploy.
JUDGE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Polly has no hi-IN voice. Kajal is en-IN with hi-IN in AdditionalLanguageCodes and is the only
# Hindi-capable neural voice, so both languages are this voice with a different LanguageCode.
DEBRIEF_VOICE_ID=Kajal
# The scoring Lambdas read AWS_REGION from Lambda itself; DATA_REGION is the same value under a
# name Lambda does not reserve. Set by CDK on each function, listed here for reference only.
# DATA_REGION=ap-south-1

# Nothing in this block is an Amplify environment variable. The whole scoring path runs server
# side under IAM roles: the agent starts the execution, the Lambdas read their own config, and
# the web app only presigns debrief/<drillId>.mp3 with the compute role it already has.

# ---- Later phases: leave empty until the resource exists ----------------------------------
# Phase 3, output of the AgentCore Runtime deploy
AGENT_RUNTIME_ARN=
# Phase 6, Verified Permissions
POLICY_STORE_ID=

# ---- Phase 8, deferred. A real secret: .env.local only, never here ------------------------
# FAL_KEY=
