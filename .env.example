# Chaukanna environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.

# Primary app & data region
AWS_REGION=ap-south-1

# Voice agent region (Nova 2 Sonic)
VOICE_REGION=ap-northeast-1

# DynamoDB table name (from CDK output)
TABLE_NAME=chaukanna

# S3 artifacts bucket name (from CDK output)
ARTIFACTS_BUCKET=

# Cognito (from CDK output)
USER_POOL_ID=
USER_POOL_CLIENT_ID=
COGNITO_DOMAIN=

# Verified Permissions policy store ID (from CDK output)
POLICY_STORE_ID=

# AgentCore Runtime ARN (from CDK output)
AGENT_RUNTIME_ARN=

# Bedrock model IDs
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
JUDGE_MODEL_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# Scoring state machine ARN (from CDK output)
SCORING_STATE_MACHINE_ARN=

# Agent safety settings
SESSION_MAX_SECONDS=360
SAFE_WORD=ROKO

# fal.ai key for debrief video clips (Phase 8 deferred)
# FAL_KEY=
